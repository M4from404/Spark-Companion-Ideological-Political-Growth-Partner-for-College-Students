let curAudio = null, bubbleTimer = null;
let speakEpoch = 0;        // 语音纪元：新语音请求递增，旧链检测到变化就中止
function updateSpeechControls(){$('stopVoiceBtn').hidden=!(replyReading||curAudio)}
function stopCurrentSpeech(){
