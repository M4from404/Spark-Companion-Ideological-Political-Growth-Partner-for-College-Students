// 在发送、快捷提问或语音输入的用户操作中启用同一个声音通道。
// 回答稍后到达时仍使用它播放，不再创建受自动播放策略限制的 Audio 元素。
function prepareReplyAudio(){
  if(!voiceOn)return null;
  try{
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    if(!AudioContext)return null;
    if(!replyAudioContext || replyAudioContext.state==='closed')replyAudioContext=new AudioContext();
    if(replyAudioContext.state!=='running'){
      replyAudioContext.resume().catch(()=>{});
      const silence=replyAudioContext.createBufferSource();
      silence.buffer=replyAudioContext.createBuffer(1,1,replyAudioContext.sampleRate);
      silence.connect(replyAudioContext.destination);
      silence.onended=()=>silence.disconnect();
      silence.start();
    }
    return replyAudioContext;
  }catch(e){return null}
}

function loadVoices(){
  if(!synth) return;
  const vs = synth.getVoices();
  // 普通话(zh-CN)排最前，粤语(zh-HK/zh-MO)与台湾(zh-TW)排最后，避免备用音色落到粤语「曉佳」上
  zhVoices = vs.filter(v => /^zh|cmn/i.test(v.lang)).sort((a,b)=>{
    const rank = v => {
      const l=(v.lang||'').toLowerCase(), n=(v.name||'').toLowerCase();
      if(l==='zh-cn' || /mainland|simplified|mandarin|putonghua/.test(n)) return 0;
      if(/cantonese|yue/.test(n) || /zh-(hk|mo)/i.test(l)) return 3;
      if(/zh-tw/i.test(l) || /taiwan|traditional/.test(n)) return 2;
      return 1;
    };
    return rank(a)-rank(b);
  });
  const sel = $('voiceSel');
  sel.innerHTML = '';
  zhVoices.forEach((v,i)=>{
    const o=document.createElement('option');
    o.value=i; o.textContent=v.name.length>22 ? v.name.slice(0,22)+'…' : v.name;
    sel.appendChild(o);
  });
  if(!zhVoices.length) return;
  const prefer = ['xiaoyi','xiaoxiao','yaoyao','online','natural'];
  let pick = 0;
  outer: for(const n of prefer){
    for(let i=0;i<zhVoices.length;i++){
      if((zhVoices[i].name||'').toLowerCase().includes(n)){ pick=i; break outer; }
    }
  }
  const saved=zhVoices.findIndex(v=>v.name===savedFallbackVoice);
  if(saved>=0)pick=saved;
  sel.value = pick;
  curVoice = zhVoices[pick];
}
if(synth){
  loadVoices();
  if('onvoiceschanged' in synth) synth.onvoiceschanged = loadVoices;
  if('addEventListener' in synth) synth.addEventListener('voiceschanged', loadVoices);
}
function voiceChanged(){
  curVoice=zhVoices[$('voiceSel').value];savedFallbackVoice=curVoice?.name||'';savePreferences();
}

