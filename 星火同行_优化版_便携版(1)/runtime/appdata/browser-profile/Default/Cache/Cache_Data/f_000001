   ================================================================ */
const ACT = {
  greet:    { src:'video/greet.mp4',    from:0.4,  to:2.4,  rest:0.0, gap:3000 },
  think:    { src:'video/think.mp4',    from:0.0,  to:4.7,  loopFrom:2.4 },
  interact: { src:'video/interact.mp4', from:0.0,  to:99,   once:true }   // 互动CG：播一遍即停
};

const player = { mode:null, gapTimer:null, interactLock:false };

/* 两个视频常驻预加载（带 SVG 抠黑滤镜，见 .char video），只显示当前动作 */
const vids = {};
