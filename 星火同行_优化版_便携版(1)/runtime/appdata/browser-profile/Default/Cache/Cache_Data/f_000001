/* 只显示当前动作的视频 */
function showActive(){
  const active=vids[player.mode];
  const ready=active && !active.error && active.readyState>=2;
  fallback.style.display=ready?'none':'block';
  Object.keys(vids).forEach(k => {
    vids[k].style.display = (k === player.mode && ready) ? 'block' : 'none';
  });
}

/* ---------- 动作控制 ---------- */
/* 播放并兼容自动播放策略：被拦截时等用户首次交互再启动 */
function tryPlay(v){
  if(document.hidden){v.pause();return}
  const p = v.play();
  if(p && p.catch) p.catch(() => {
    const kick = () => { v.play().catch(()=>{}); };
    document.addEventListener('pointerdown', kick, { once:true });
    document.addEventListener('keydown',    kick, { once:true });
  });
}

function switchTo(mode){
  if(player.mode === mode) return;
  const prev = player.mode;
  if(prev==='interact'&&mode!=='interact')player.interactLock=false;
  player.mode = mode;
  clearTimeout(player.gapTimer); player.gapTimer = null;
  if(prev && vids[prev]) vids[prev].pause();

  const cfg = ACT[mode];
  const v = vids[mode];
  setStageMode(mode);
  showActive();

  // 等视频就绪再定位播放，避免开局被静音策略/未加载导致的暂停卡死
  const boot = () => {
    if(player.mode !== mode) return;
    if(mode === 'greet'){
      // 挥手 2 秒 → 停在站立 pose → 隔 3 秒再挥一次
      const tick = () => {
        if(player.mode !== 'greet' || v.currentTime < cfg.to) return;
        v.ontimeupdate = null;
        v.pause();
        v.currentTime = cfg.rest;
        player.gapTimer = setTimeout(() => {
          if(player.mode !== 'greet') return;
          v.currentTime = cfg.from;
          v.ontimeupdate = tick;
          tryPlay(v);
        }, cfg.gap);
      };
      v.ontimeupdate = tick;
    }else if(mode === 'interact'){
      // 互动CG：完整播一遍挥手反应，结束后回到 greet 待机
      v.onended = () => {
        v.onended = null; v.ontimeupdate = null;
        player.interactLock = false;
        if(player.mode === 'interact') charIdle();
      };
      v.ontimeupdate = () => {
        if(player.mode !== 'interact') return;
        if(v.currentTime >= (cfg.to === 99 ? (v.duration || 3) : cfg.to)){
          v.pause();
          v.onended && v.onended();
        }
      };
    }else{
      // 思考：先完整播一遍（鞠躬→起身→托腮），之后循环头部左右摆动段
      // 注意 seek 之后必须显式续播——视频一旦自然 ended 就会停在暂停态
      const wrap = () => {
        if(player.mode !== 'think') return;
        if(v.currentTime >= cfg.to){
          v.currentTime = cfg.loopFrom;
          if(v.paused) tryPlay(v);
        }
      };
      v.ontimeupdate = wrap;
      v.onended = () => {
        if(player.mode !== 'think') return;
        v.currentTime = cfg.loopFrom;
        tryPlay(v);
      };
    }
    v.currentTime = cfg.from;
    tryPlay(v);
  };

  if(v.readyState >= 2) boot();
  else v.addEventListener('loadeddata', boot, { once:true });
}

function setStageMode(m){
  const st = $('stage');
  if(st) st.classList.toggle('thinking', m === 'think');
}

/* 对外暴露的意图接口 */
