/* ================================================================
   思考过程过滤器（前端兜底）
   ----------------------------------------------------------------
   免 Key 匿名接口会在不同上游之间切换，模型可能把"思考过程"写进正文：
     a. <think>…</think>              —— 本机服务只处理这一种
     b. <thinking> / <analysis> / <reasoning> 等其它标签
     c. 只有 </think> 没有 <think>（开始标签被上游模板吃掉）
     d. 完全没有标签，直接把英文推理写在正文前面
   这里在前端再做一层兜底：显示、朗读、聊天记录都只用过滤后的文本。
   ================================================================ */
function createThinkingFilter(){
  const NAMES = 'think|thinking|analysis|reasoning|reflection|scratchpad|thought|chain|cot';
  const OPEN  = new RegExp('<(' + NAMES + ')\\s*>', 'i');
  const CLOSE = new RegExp('</(' + NAMES + ')\\s*>', 'i');
  const CTRL  = /<\|[^|]*\|>/g;
  const META  = /^(we need|we should|we must|we can|we'll|we are|we have|the user|the question|the task|the prompt|the instruction|the assistant|let me|let's|i should|i need|i'll|i will|i'm going|response|okay|ok\b|hmm|alright|first,|thinking|analysis|reasoning|this is|given the|so the|sure,)/i;
  const MAX_PROBE = 400;          // 开头最多缓冲多少字符再判定

  let mode = 'head';              // head 判定开头 / body 正文 / hidden 标签内 / drop 整条丢弃
  let buf  = '';

  const looksLikeReasoning = s => {
    const t = (s || '').trim();
    if(t.length < 10) return false;                  // 太短（如 OK、好的）不当成推理
    const ascii = (t.match(/[A-Za-z]/g) || []).length;
    return META.test(t) || ascii >= 24;
  };

  // 处理 harmony 风格的通道标记：只保留 final 通道，丢掉 analysis / commentary 通道
  function stripHarmony(s){
    const fm = /final\s*<\|message\|>/i.exec(s);
    if(fm) s = s.slice(fm.index + fm[0].length);
    s = s.replace(/<\|channel\|>\s*(?:analysis|commentary)\s*<\|message\|>[\s\S]*?(?:<\|end\|>|$)/gi, '');
    s = s.replace(/(?:analysis|commentary)\s*<\|[^|]*\|>[\s\S]*?(?:<\|end\|>|$)/gi, '');
    s = s.replace(/<\|channel\|>\s*(?:analysis|commentary)\s*/gi, '');
    return s.replace(CTRL, '');
  }

  // 去掉残留的思考标签，返回处理后的文本与是否停在"未闭合标签"里
  function stripTags(s){
    let unclosed = false;
    for(let i = 0; i < 12; i++){
      s = stripHarmony(s);
      const c = CLOSE.exec(s);
      if(c && !OPEN.test(s.slice(0, c.index))){
        s = s.slice(c.index + c[0].length).replace(/^[\s\n]+/, '');
        continue;
      }
      const o = OPEN.exec(s);
      if(!o) break;
      const rest = s.slice(o.index + o[0].length);
      const cm = CLOSE.exec(rest);
      if(cm){
        s = s.slice(0, o.index) + rest.slice(cm.index + cm[0].length);
        continue;
      }
      s = s.slice(0, o.index);
      unclosed = true;
      break;
    }
    return { text: s, unclosed };
  }

  return {
    push(chunk){
      if(mode === 'drop') return '';
      buf += chunk;
      let out = '';
      for(let guard = 0; guard < 40; guard++){
        if(mode === 'hidden'){
          const cm = CLOSE.exec(buf);
          if(!cm){ buf = buf.slice(-13); return out; }   // 标签内内容丢弃，只留可能是半个结束标签的尾巴
          buf = buf.slice(cm.index + cm[0].length);
          mode = 'head';
          continue;
        }
        const r = stripTags(buf);
        if(r.unclosed){ buf = ''; mode = 'hidden'; return out; }
        if(mode === 'body'){ out += r.text; buf = ''; return out; }
        buf = r.text;
        const i = buf.search(/[\u4e00-\u9fff]/);
        if(i < 0){
          if(buf.length > MAX_PROBE){
            if(looksLikeReasoning(buf)){ buf = ''; mode = 'drop'; }
            else { out += buf; buf = ''; mode = 'body'; }
            return out;
          }
          return out;                               // 还判断不了，继续缓冲
        }
        if(i > 0 && looksLikeReasoning(buf.slice(0, i))) buf = buf.slice(i);
        mode = 'body';
        continue;
      }
      return out;
    },
    end(){
      if(mode === 'drop'){ buf = ''; return ''; }
      if(mode === 'hidden'){ buf = ''; mode = 'head'; return ''; }
      const r = stripTags(buf);
      if(r.unclosed){ buf = ''; mode = 'head'; return ''; }
      let text = r.text;
      if(mode === 'head'){
        const i = text.search(/[\u4e00-\u9fff]/);
        if(i < 0){
          if(looksLikeReasoning(text)) text = '';       // 整条都是思考过程 → 不显示
        }else if(i > 0 && looksLikeReasoning(text.slice(0, i))){
          text = text.slice(i);
        }
      }
      buf = ''; mode = 'body';
      return text;
    },
    get dropped(){ return mode === 'drop'; }
  };
}

async function callLLM(onDelta){
  const ctrl=new AbortController();
  const timer=setTimeout(()=>ctrl.abort(),180000);
  const san=createThinkingFilter();       // 思考过程过滤：显示/朗读/存档都只用过滤后的文本
  let clean='', rawLen=0;
  const emit=text=>{if(!text)return;clean+=text;onDelta&&onDelta(clean,text)};
  try{
    const res=await fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({messages:history,stream:true}),signal:ctrl.signal});
    if(!res.ok || !(res.headers.get('content-type')||'').includes('application/x-ndjson')){
      const data=await res.json().catch(()=>({}));
      if(!res.ok)throw new Error(data.error||('模型服务请求失败（HTTP '+res.status+'）'));
      if(typeof data.content==='string')emit(san.push(data.content));
    }else{
      const reader=res.body.getReader(),decoder=new TextDecoder();
      let pending='',complete=false;
      const consume=line=>{
        if(!line.trim())return;
        const event=JSON.parse(line);
        if(event.type==='error')throw new Error(event.error||'回复连接中断，请稍后重试');
        if(event.type==='done'){complete=true;return}
        if(event.type==='delta'&&typeof event.text==='string'&&!complete){
          rawLen+=event.text.length;
          if(rawLen>1024*1024)throw new Error('回复内容过长，请重新发送');
          emit(san.push(event.text));
        }
      };
      try{
        while(!complete){
          const {value,done}=await reader.read();
          pending+=decoder.decode(value,{stream:!done});
          let newline;
          while((newline=pending.indexOf('\n'))>=0){consume(pending.slice(0,newline));pending=pending.slice(newline+1)}
          if(done){if(pending.trim())consume(pending);break}
        }
      }finally{await reader.cancel().catch(()=>{})}
      if(!complete)throw new Error('连接中断，本条回复未完整生成，请重新发送');
    }
    emit(san.end());
    if(!clean.trim()){
      if(san.dropped||rawLen>0)throw new Error('这条回复没生成好，请再发一次试试。');
      throw new Error('模型暂时没有返回正文，请稍后再试');
    }
    return clean.trim();
  }catch(e){
    if(e.name==='AbortError') throw new Error('等待回复超时。本地模型推理较慢时请耐心等待，或改用更小的模型');
    throw e;
  }finally{clearTimeout(timer)}
}

/* ---------------- 发送流程 ---------------- */
async function send(){
  const inp=$('txt'),text=inp.value.trim();
  if(!text||busy)return;
  inp.value='';await chat(text);
}
async function chat(userText,reuseUser=null){
  if(busy||!userText.trim())return;
  prepareReplyAudio();
  busy=true;$('sendBtn').disabled=true;
  document.querySelectorAll('.chip,.retry-btn').forEach(b=>b.disabled=true);
  stopSpeak();charThink();setStatus('晚晴正在想…');
  const userBubble=reuseUser&&reuseUser.isConnected?reuseUser:addMsg('me',userText);
  scrollLatest(true);history.push({role:'user',content:userText});
  const typing=addTyping();
  const renderer=messageRenderer(typing);
  const waiting=setTimeout(()=>setStatus('模型正在生成回复，请稍等…'),8000);
  let speech=null,partial=false;
  try{
    const reply=await callLLM((full,delta)=>{
      clearTimeout(waiting);renderer.update(full);
      if(!partial){partial=true;charIdle();setStatus('晚晴正在回复…')}
      if(voiceOn&&!speech)speech=createReplySpeech();
      if(speech)speech.append(delta);
    });
    clearTimeout(waiting);renderer.flush(reply);
    history.push({role:'assistant',content:reply});trimHistory();
    try{sessionStorage.setItem('xinghuo-chat',JSON.stringify(history.slice(1)))}catch(e){}
    charIdle();setStatus('本地模型对话 · 可以继续聊天');
    if(speech)speech.finish();
  }catch(e){
    stopSpeak();
    renderer.flush();
    if(!partial)typing.remove();
    history.pop();
    const failure=addMsg('sys',e.message||'模型请求失败，请稍后再试');
    const retry=document.createElement('button');retry.type='button';retry.className='retry-btn';retry.textContent='重试';
    retry.onclick=()=>{
      if(busy)return;
      if(failure===log.lastElementChild){
        failure.remove();typing.remove();chat(userText,userBubble);
      }else chat(userText);
    };
    failure.appendChild(retry);scrollLatest();
    setStatus('回复失败 · 检查网络或稍后重试');charIdle();
  }finally{
    clearTimeout(waiting);busy=false;$('sendBtn').disabled=false;
    document.querySelectorAll('.chip,.retry-btn').forEach(b=>b.disabled=false);
  }
}
function quick(el){chat(el.textContent)}

/* ---------------- 语音输入（Chrome/Edge 识别） ---------------- */
const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
let rec = null, recOn = false;
if(SR){
  rec = new SR();
  rec.lang = 'zh-CN';
  rec.continuous = false;
  rec.interimResults = false;
  rec.onresult = e => {
    const t = e.results[0][0].transcript;
    $('txt').value = t;
    send();
  };
  rec.onend = () => { recOn = false; $('micBtn').classList.remove('rec'); };
  rec.onerror = e => { recOn = false; $('micBtn').classList.remove('rec');
    addMsg('sys',e.error==='not-allowed'?'麦克风权限未开启，请在浏览器设置中允许麦克风。':'语音输入暂不可用，请检查麦克风和网络，或直接打字。'); };
}
function toggleMic(){
  if(!rec){ addMsg('sys','当前浏览器不支持语音输入，可直接打字哦'); return; }
  if(recOn){ rec.stop(); return; }
  prepareReplyAudio();
  stopSpeak();
  recOn = true;
  $('micBtn').classList.add('rec');
  try{ rec.start(); }catch(e){ recOn=false; $('micBtn').classList.remove('rec'); }
}

$('txt').addEventListener('keydown', e => { if(e.key==='Enter'&&!e.isComposing) send(); });

/* ---------------- 开场与当前会话恢复 ---------------- */
const GREETING='嘿！我是楚晚晴，你的成长应援团。学业、心情、党史知识，想聊什么都可以。点击上方“思政闯关”开始学习；联网后直接和我聊天，无需填写密钥。';
preferencesReady=loadPreferences();
switchTo('greet');setStatus('本地模型对话 · 无需 Key');
let restored=false;
try{
  const entries=JSON.parse(sessionStorage.getItem('xinghuo-chat')||'[]');
  if(Array.isArray(entries)){
    for(const item of entries.slice(-MAX_TURNS)){
      if(item&&['user','assistant'].includes(item.role)&&typeof item.content==='string'){
        history.push(item);addMsg(item.role==='user'?'me':'ai',item.content);restored=true;
      }
    }
  }
}catch(e){}
if(!restored){
  addMsg('ai',GREETING);
  setTimeout(()=>preferencesReady.then(()=>{
    if(busy||replyReading||history.some(m=>m.role==='user'))return;
    playLocalLine('嘿！我是楚晚晴，你的成长应援团！','voice/v00.mp3')
      .catch(()=>{if(!busy&&!replyReading)setVoiceStatus('对话回复将自动朗读',false)});
  }),600);
}
window.addEventListener('pagehide',()=>{stopSpeak();if(recOn)rec.stop()});
