async function loadPreferences(){
  const ctrl=new AbortController(),timer=setTimeout(()=>ctrl.abort(),2500);
  try{
    const response=await fetch('/api/preferences',{signal:ctrl.signal});
    if(!response.ok)return;
    const data=await response.json();
    if(preferencesTouched)return;
    voiceOn=data.voiceOn!==false;ttsEngine=data.engine==='child'?'child':'fast';
    savedFallbackVoice=typeof data.fallbackVoice==='string'?data.fallbackVoice:'';
    if(!voiceOn)stopSpeak();
    renderVoiceControls();loadVoices();
    if(!replyReading)setVoiceStatus(voiceOn?'回复将自动朗读 · '+engineLabel():'自动朗读已关闭');
  }catch(e){}finally{clearTimeout(timer)}
}
function savePreferences(){
  preferencesTouched=true;
  const data={voiceOn,engine:ttsEngine,fallbackVoice:savedFallbackVoice};
  // Serialize writes so the last click wins, even when the user toggles rapidly.
  preferenceWrite=preferenceWrite.catch(()=>{}).then(async()=>{
    const response=await fetch('/api/preferences',{method:'POST',keepalive:true,
      headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
    if(!response.ok)throw new Error('设置保存失败');
  }).catch(()=>setVoiceStatus('声音设置暂未保存，当前窗口仍可使用',true));
  return preferenceWrite;
}
let pingTimer = null;
function pingServer(){
  const ctrl = new AbortController();
  const to = setTimeout(() => ctrl.abort(), 2500);   // 挂代理/VPN 时 fetch 会卡很久，必须限时
  fetch(TTS_SERVER + '/ping', { signal: ctrl.signal }).then(r => r.json()).then(d => {
    clearTimeout(to);
    if(d.ok){
      serverOK = true;
      if(!replyReading)setVoiceStatus(voiceOn ? '🎙 回复将自动朗读 · ' + engineLabel() : '自动朗读已关闭');
      schedulePing(30000);
    } else throw 0;
  }).catch(() => {
    clearTimeout(to);
    serverOK = false;
    if(!replyReading&&voiceOn)setVoiceStatus('⚠ 在线语音暂不可用，使用浏览器备用音色', true);
    schedulePing(5000);   // 断开时高频重试，服务一启动几秒内就能恢复
  });
}
function schedulePing(ms){
  clearTimeout(pingTimer);
  pingTimer = setTimeout(pingServer, ms);
}
pingServer();

