/* ---------------- 甜美语音引擎 ----------------
   主音色：Edge-TTS 神经语音；服务不可用时回退浏览器内置中文女声。 */
const TTS_SERVER = location.origin;
const synth = window.speechSynthesis;
let voiceOn = true, zhVoices = [], curVoice = null, serverOK = false;
let replyAudioContext = null, replyAbort = null, replyCancel = null, replyReading = false;
const replyRequests = new Set();
let replySessionCancel = null;
const scheduledSpeech = new Set();
function cancelScheduledSpeech(){for(const cancel of Array.from(scheduledSpeech))cancel()}
let savedFallbackVoice='',preferencesTouched=false,preferenceWrite=Promise.resolve();
