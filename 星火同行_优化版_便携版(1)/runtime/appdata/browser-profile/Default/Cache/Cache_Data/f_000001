function stopSpeak(){
  speakEpoch++;            // 让所有正在 await 的语音链感知到自己已过期
  replyReading=false;
  for(const ctrl of replyRequests)ctrl.abort();
  replyRequests.clear();replyAbort=null;
  if(replySessionCancel){const cancel=replySessionCancel;replySessionCancel=null;cancel()}
  if(replyCancel){const cancel=replyCancel;replyCancel=null;cancel()}
  if(curAudio){ try{ curAudio.pause(); }catch(e){} curAudio = null; }
  if(bubbleTimer){ clearInterval(bubbleTimer); bubbleTimer = null; }
  if(synth) try{ synth.cancel(); }catch(e){}
  clearInterval(popTimer);
  updateSpeechControls();
  // 语音一停就回到打招呼待机，除非当前正处在思考态或互动CG中
  if(typeof player !== 'undefined' && player.mode !== 'think' && player.mode !== 'interact') charIdle();
}

/* 首段用短句尽快开口，后续在自然停顿处分块，并提前准备下一段。 */
function splitSentences(text){
  const parts = text.replace(/\s+/g,' ').split(/(?<=[。！？!?；;~])/);
  return parts.filter(s=>s.trim());
}
function splitChunks(text){
  const out=[];let rest=text;
  while(rest){const n=speechChunkLength(rest,true,!out.length);out.push(rest.slice(0,n));rest=rest.slice(n)}
  return out.filter(s=>cleanForTTS(s));
}
function speechChunkLength(text,final,first){
  const limit=first?48:140,min=first?14:60;
  const prefix=text.slice(0,limit);
  const stops=Array.from(prefix.matchAll(/[。！？!?；;\n]/g),m=>m.index+1).filter(n=>n>=min);
  if(stops.length)return first?stops[0]:stops[stops.length-1];
  if(text.length>=limit){
    const commas=Array.from(prefix.matchAll(/[，,：: ]/g),m=>m.index+1).filter(n=>n>=min);
    return commas.length?commas[commas.length-1]:limit;
  }
  return final?text.length:0;
}

/* 送进 TTS 前清理 Markdown、表情符号与标点；屏幕文字仍保留原样。 */
function cleanForTTS(text){
  let t = '' + text;
  // markdown 强调符号
  t = t.replace(/\*\*([\s\S]*?)\*\*/g, '$1');
  t = t.replace(/\*([\s\S]*?)\*/g, '$1');
  t = t.replace(/__([\s\S]*?)__/g, '$1');
  t = t.replace(/_([\s\S]*?)_/g, '$1');
  // Unicode 标点和符号覆盖中文标点、emoji、箭头及 Markdown 装饰符号。
  t = t.replace(/[\p{P}\p{S}\u{200D}\u{FE0F}\u{20E3}]/gu, ' ');
  t = t.replace(/\s+/g, ' ');
  return t.trim();
}

/* 请求本地服务合成语音 */
function ttsUrl(text){
  return TTS_SERVER + '/tts?engine=' + ttsEngine + '&text=' + encodeURIComponent(text);
}

/* 合成与播放分开，让下一段在当前段朗读时就准备好。 */
async function prepareReplyChunk(text,epoch,waitMs=22000){
  const active=()=>epoch===speakEpoch&&voiceOn;
  if(!active())return;
  const context=replyAudioContext || prepareReplyAudio();
  if(!context)throw new Error('当前浏览器不支持音频播放');
  const ctrl=new AbortController();replyAbort=ctrl;replyRequests.add(ctrl);
  const timeout=setTimeout(()=>ctrl.abort(),waitMs);
  let bytes;
  try{
    const response=await fetch(ttsUrl(cleanForTTS(text)),{signal:ctrl.signal});
    if(!response.ok || !(response.headers.get('content-type')||'').startsWith('audio/'))throw new Error('语音合成暂不可用');
    bytes=await response.arrayBuffer();
  }finally{
    clearTimeout(timeout);
    replyRequests.delete(ctrl);
    if(replyAbort===ctrl)replyAbort=Array.from(replyRequests).at(-1)||null;
  }
  if(!active())return;
  const buffer=await context.decodeAudioData(bytes);
  if(!active())return;
  return {context,buffer};
}
// Remove only detected silence around generated audio, keeping a soft onset and ending.
function speechBounds(buffer){
  const rate=buffer.sampleRate,step=Math.max(1,Math.round(rate*.01));
  let first=-1,last=-1;
  for(let start=0;start<buffer.length;start+=step){
    const end=Math.min(buffer.length,start+step);let energy=0;
    for(let channel=0;channel<buffer.numberOfChannels;channel++){
      const samples=buffer.getChannelData(channel);
      for(let i=start;i<end;i++)energy+=samples[i]*samples[i];
    }
    if(Math.sqrt(energy/((end-start)*buffer.numberOfChannels))>.0015){if(first<0)first=start;last=end}
  }
  if(first<0)return {offset:0,duration:buffer.duration};
  const offset=Math.max(0,Math.min(first/rate-.06,2));
  const end=Math.min(buffer.duration,Math.max(last/rate+.12,buffer.duration-2));
  return {offset,duration:end-offset};
}
async function playReplyChunk(text,epoch,prepared,when=0){
  const active=()=>epoch===speakEpoch&&voiceOn;
  if(!active())return;
  const result=await prepared;
  if(!active()||!result)return;
  if(result.error)throw result.error;
  const {context,buffer}=result.audio;
  if(context.state!=='running'){
    let resumeTimer;
    try{
      await Promise.race([context.resume(),new Promise((_,reject)=>{
        resumeTimer=setTimeout(()=>reject(new Error('音频通道未就绪')),1500);
      })]);
    }finally{clearTimeout(resumeTimer)}
  }
  if(!active())return;
  if(context.state!=='running')throw new Error('音频通道未就绪');
  const bounds=speechBounds(buffer),startAt=Math.max(context.currentTime+.025,when);
  const endTime=startAt+bounds.duration;
  const done=new Promise((resolve,reject)=>{
    const source=context.createBufferSource();
    source.buffer=buffer;source.connect(context.destination);
    let settled=false,playTimer,startTimer;
    const cancel=()=>finish();
    function finish(error){
      if(settled)return;settled=true;
      clearTimeout(playTimer);clearTimeout(startTimer);source.onended=null;
      try{source.stop()}catch(e){}
      source.disconnect();
      scheduledSpeech.delete(cancel);
      if(!scheduledSpeech.size&&replyCancel===cancelScheduledSpeech){replyCancel=null;clearInterval(popTimer)}
      if(error)reject(error);else resolve();
    }
    scheduledSpeech.add(cancel);replyCancel=cancelScheduledSpeech;
    source.onended=()=>finish();
    playTimer=setTimeout(()=>finish(new Error('语音播放超时')),(endTime-context.currentTime)*1000+5000);
    try{
      source.start(startAt,bounds.offset,bounds.duration);
      startTimer=setTimeout(()=>{
        if(!active())return;
        showBubble(text);setVoiceStatus('🔊 正在自动朗读 · '+engineLabel());
        clearInterval(popTimer);popTimer=setInterval(spawnPop,300);
      },Math.max(0,(startAt-context.currentTime)*1000));
    }catch(e){finish(e)}
  });
  // A queued source can fail before the pump reaches it; attach its handler now.
  done.catch(()=>{});
  return {done,endTime};
}

/* 播放已预取的音频块：说话动画 + 气泡按子句同步推进 */
function playChunk(audioObj, chunkText, epoch){
  const {a,getErr}=audioObj;
  if(epoch!==speakEpoch || !voiceOn)return Promise.resolve();
  return new Promise((resolve,reject)=>{
    curAudio=a;updateSpeechControls();let settled=false;
    const listeners=[];
    function on(type,fn){a.addEventListener(type,fn);listeners.push([type,fn])}
    function done(error){
      if(settled)return;settled=true;
      clearTimeout(timeout);clearInterval(cancelCheck);
      listeners.forEach(([type,fn])=>a.removeEventListener(type,fn));
      if(curAudio===a){curAudio=null;clearInterval(popTimer);updateSpeechControls()}
      if(error){a.pause();reject(error)}else resolve();
    }
    const timeout=setTimeout(()=>done(new Error('语音播放超时')),60000);
    const cancelCheck=setInterval(()=>{
      if(epoch!==speakEpoch||!voiceOn){a.pause();done()}
    },100);
    on('playing',()=>{
      if(epoch!==speakEpoch){a.pause();done();return}
      showBubble(chunkText);clearInterval(popTimer);popTimer=setInterval(spawnPop,300);
    });
    on('error',()=>done(new Error('音频加载失败')));
    on('ended',()=>done());
    on('pause',()=>{if(epoch!==speakEpoch)done()});
    if(getErr()){done(new Error('音频加载失败'));return}
    a.play().catch(e=>done(e));
  });
}

/* 首段有足够播放时间就立即开口；保留同一甜声音色并提前准备后续音频。 */
function createReplySpeech(){
  stopSpeak();
  const epoch=speakEpoch,queue=[],playing=[];
  let pending='',first=true,closed=false,running=false,stopped=false,fallback=false,resolveDone,fallbackVoice=null;
  let quietTimer=null,started=false,nextStart=0,wakePump=null;
  const localVoice=zhVoices.find(v=>v.localService);
  const done=new Promise(resolve=>{resolveDone=resolve});
  const active=()=>!stopped&&epoch===speakEpoch&&voiceOn;
  replyReading=true;
  updateSpeechControls();
  const cancel=()=>{stopped=true;clearTimeout(quietTimer);queue.length=0;pending='';resolveDone()};
  replySessionCancel=cancel;
  function complete(error){
    if(stopped)return;
    stopped=true;clearTimeout(quietTimer);
    if(replySessionCancel===cancel)replySessionCancel=null;
    if(epoch===speakEpoch){
      if(error){for(const ctrl of replyRequests)ctrl.abort();cancelScheduledSpeech()}
      replyReading=false;clearInterval(popTimer);
      updateSpeechControls();
      setVoiceStatus(error?'本次朗读未成功，请检查网络和系统声音；可继续阅读文字':'朗读完成 · 下一条回复将自动朗读',!!error);
      setTimeout(()=>{if(epoch===speakEpoch)bubble.classList.remove('on')},1200);
    }
    resolveDone();
  }
  function prefetch(){
    if(!active()||fallback)return;
    const slots=Math.max(0,3-playing.length);
    for(const item of queue.slice(0,slots)){
      // Convert rejection to a value immediately: cancellation of a prefetched
      // chunk must never create an unhandled rejection while another chunk plays.
      if(!item.ready)item.ready=prepareReplyChunk(item.text,epoch)
        .then(audio=>audio?{audio}:null,error=>({error}));
    }
  }
  async function pump(){
    if(running||!active())return;
    running=true;
    try{
      while(queue.length&&active()){
        prefetch();const item=queue[0];
        if(!fallback){
          try{
            let ready,bufferTimer;
            try{
              if(started)bufferTimer=setTimeout(()=>{
                if(active())setVoiceStatus('正在准备下一句 · 保持'+engineLabel());
              },Math.max(0,(nextStart-replyAudioContext.currentTime)*1000)+250);
              // Brief buffering must not change the character's voice. Only an
              // actual synthesis/playback failure enters the fallback below.
              ready=await item.ready;
            }finally{clearTimeout(bufferTimer)}
            if(ready?.error)throw ready.error;
            if(!active())return;
            if(!started&&ready?.audio&&queue[1]){
              const duration=speechBounds(ready.audio.buffer).duration;
              // A normal first sentence covers the next request's preparation.
              // Only a very short greeting needs a small, bounded head start.
              if(duration<2.5){
                let timer;
                try{
                  await Promise.race([queue[1].ready,new Promise(resolve=>{
                    timer=setTimeout(resolve,1200);
                  })]);
                }finally{clearTimeout(timer)}
              }
            }
            if(!active())return;
            const playback=await playReplyChunk(item.text,epoch,ready,nextStart);
            if(!active()||!playback)return;
            started=true;nextStart=playback.endTime;
            playback.done.then(()=>{playback.finished=true},()=>{playback.finished=true});
            playing.push(playback);queue.shift();
            // Keep at most three queued/playing sources, but do not wait for
            // onended to schedule the next one on the audio clock.
            if(playing.length>=3)await playing.shift().done;
            prefetch();continue;
          }
          catch(e){
            if(!active())return;
            fallback=true;
            for(const ctrl of replyRequests)ctrl.abort();
            fallbackVoice=localVoice||curVoice;
            setVoiceStatus('在线朗读未成功，正在使用备用音色',true);
          }
        }
        if(!active())return;
        if(fallback){
          await Promise.all(playing.splice(0).map(p=>p.done));
          if(!active())return;
          const remainder=queue.splice(0).map(part=>part.text).join('');
          await speakFallbackTTS(remainder,epoch,fallbackVoice);
          continue;
        }
      }
      if(playing.length){
        await Promise.race([Promise.all(playing.map(p=>p.done)),new Promise(resolve=>{wakePump=resolve})]);
        wakePump=null;
        for(let i=playing.length-1;i>=0;i--)if(playing[i].finished)playing.splice(i,1);
      }
      if(closed&&!queue.length&&!playing.length&&active())complete();
    }catch(e){if(active())complete(e)}
    finally{running=false;if(queue.length&&active())pump()}
  }
  function append(text,final=false){
    if(!active())return;
    clearTimeout(quietTimer);
    pending+=text;
    while(pending){
      const n=speechChunkLength(pending,final,first);
      if(!n)break;
      const chunk=pending.slice(0,n);pending=pending.slice(n);
      if(cleanForTTS(chunk)){queue.push({text:chunk,ready:null,first});first=false}
    }
    if(final)closed=true;
    if(queue.length){if(wakePump)wakePump();prefetch();pump()}
    else if(closed&&!running)complete();
    if(!closed&&/[。！？!?][\s”’]*$/.test(pending)&&cleanForTTS(pending).length>=4){
      // A genuinely slow text stream can still speak one complete short sentence.
      quietTimer=setTimeout(()=>{
        if(!active()||!pending)return;
        queue.push({text:pending,ready:null,first});pending='';first=false;
        if(wakePump)wakePump();prefetch();pump();
      },first?180:250);
    }
  }
  setVoiceStatus('正在准备自动朗读…');
  return {append,finish:()=>append('',true),done};
}
async function speakText(text){
  if(!voiceOn||!cleanForTTS(text))return;
  const speech=createReplySpeech();speech.append(text);speech.finish();
  await speech.done;
}

/* 备用：浏览器 TTS，逐句朗读 */
async function speakFallbackTTS(text,epoch=speakEpoch,overrideVoice=null){
  if(!voiceOn || !text.trim() || epoch!==speakEpoch)return;
  if(!synth)throw new Error('系统语音不可用');
  for(const sentence of splitSentences(text).map(cleanForTTS).filter(Boolean)){
    if(!voiceOn || epoch!==speakEpoch)return;
    await new Promise((resolve,reject)=>{
      const u=new SpeechSynthesisUtterance(sentence);
      const chosen=overrideVoice||curVoice;
      u.lang='zh-CN';if(chosen)u.voice=chosen;
      const natural=chosen&&/online|natural/i.test(chosen.name||'');
      u.pitch=natural?1.18:1.42;u.rate=natural?1.0:0.92;
      let settled=false;
      const cancel=()=>finish();
      const timer=setTimeout(()=>finish(new Error('系统语音播放超时')),60000);
      function finish(error){
        if(settled)return;settled=true;clearTimeout(timer);
        u.onend=null;u.onerror=null;
        if(replyCancel===cancel){replyCancel=null;clearInterval(popTimer)}
        if(error){synth.cancel();reject(error)}else resolve();
      }
      replyCancel=cancel;
      u.onend=()=>finish();
      u.onerror=()=>finish(new Error('系统语音播放失败'));
      showBubble(sentence);clearInterval(popTimer);popTimer=setInterval(spawnPop,220);
      try{synth.speak(u)}catch(e){finish(e)}
    });
  }
}

